# Enhanced Financial Analysis Application Configuration
# Copy this file to .env and adjust settings as needed

# =============================================================================
# API SETTINGS
# =============================================================================

# Yahoo Finance API settings (no API key required - free service)
# Maximum daily API calls
MAX_DAILY_API_CALLS=1000

# Cache settings (in hours)
PRICE_CACHE_DURATION=24
NEWS_CACHE_DURATION=6
COMPANY_INFO_CACHE_DURATION=168  # 1 week

# =============================================================================
# MODEL SETTINGS
# =============================================================================

# Sentiment analysis model settings
FINBERT_MODEL=ProsusAI/finbert
SENTIMENT_RETRAIN_THRESHOLD=0.7

# Model weights for ensemble analysis
TECHNICAL_WEIGHT=0.6
SENTIMENT_WEIGHT=0.3
FUNDAMENTAL_WEIGHT=0.1

# =============================================================================
# RISK MANAGEMENT
# =============================================================================

# Position sizing
MAX_POSITION_SIZE=0.1  # 10% of portfolio
RISK_TOLERANCE=0.02    # 2% risk per trade

# Technical analysis thresholds
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_THRESHOLD=0.01

# =============================================================================
# LOGGING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log to file
LOG_TO_FILE=true
LOG_FILE=financial_analysis.log

# =============================================================================
# MONITORING
# =============================================================================

# Default monitoring interval (hours)
DEFAULT_MONITOR_INTERVAL=6

# Alert thresholds
HIGH_CONFIDENCE_ALERT=true
EXTREME_RSI_ALERT=true
HIGH_RISK_ALERT=true
API_USAGE_ALERT_THRESHOLD=80  # Percentage

# =============================================================================
# DATA SETTINGS
# =============================================================================

# Default stock symbol
DEFAULT_SYMBOL=AAPL

# Cache directory
CACHE_DIR=cache

# Models directory
MODELS_DIR=models

# Data retention (days)
PRICE_DATA_RETENTION=365
NEWS_DATA_RETENTION=30
LOG_RETENTION=90